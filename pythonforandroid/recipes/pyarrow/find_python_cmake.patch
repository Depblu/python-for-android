 set(PYTHON_LIBRARIES ${Python3_LIBRARIES})
 set(PYTHON_OTHER_LIBS)
 
-get_target_property(NUMPY_INCLUDE_DIRS Python3::NumPy INTERFACE_INCLUDE_DIRECTORIES)
