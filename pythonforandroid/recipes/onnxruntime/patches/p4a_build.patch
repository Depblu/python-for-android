+    else()
+      message(WARNING "  Could not get IMPORTED_LOCATION or IMPORTED_LOCATION_RELEASE for Python::Python.")
+    endif()
+  endif()
+
+  # 检查 INTERFACE_INCLUDE_DIRECTORIES (指向头文件目录)
+  get_target_property(_py_includes Python::Python INTERFACE_INCLUDE_DIRECTORIES)
